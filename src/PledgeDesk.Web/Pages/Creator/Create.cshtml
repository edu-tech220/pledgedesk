@page
@model PledgeDesk.Web.Pages.Creator.CreateModel
@{
    ViewData["Title"] = "Launch a campaign";
}

<h1>Launch a campaign</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Category" class="form-label"></label>
        <input asp-for="Input.Category" class="form-control" />
        <span asp-validation-for="Input.Category" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.GoalAmount" class="form-label"></label>
        <input asp-for="Input.GoalAmount" class="form-control" />
        <span asp-validation-for="Input.GoalAmount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.DeadlineUtc" class="form-label"></label>
        <input asp-for="Input.DeadlineUtc" class="form-control" />
        <span asp-validation-for="Input.DeadlineUtc" class="text-danger"></span>
    </div>

    <p class="text-muted">The campaign starts as a Draft. Add reward tiers, then activate it from the manage page.</p>

    <button type="submit" class="btn btn-primary">Create draft</button>
</form>
