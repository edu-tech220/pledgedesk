@page
@model PledgeDesk.Web.Pages.Creator.DashboardModel
@{
    ViewData["Title"] = "My campaigns";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My campaigns</h1>
    <a asp-page="/Creator/Create" class="btn btn-primary">Launch a new campaign</a>
</div>

@if (Model.Campaigns is null || Model.Campaigns.Items.Count == 0)
{
    <p class="text-muted">You haven't launched any campaigns yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Pledged</th>
                <th>Goal</th>
                <th>Deadline</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var campaign in Model.Campaigns.Items)
            {
                <tr>
                    <td>@campaign.Title</td>
                    <td><span class="badge bg-secondary">@campaign.Status</span></td>
                    <td>@campaign.PledgedAmount.ToString("C")</td>
                    <td>@campaign.GoalAmount.ToString("C")</td>
                    <td>@campaign.DeadlineUtc.ToString("yyyy-MM-dd")</td>
                    <td><a asp-page="/Creator/Manage" asp-route-id="@campaign.Id">Manage</a></td>
                </tr>
            }
        </tbody>
    </table>
}
